# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
env/

# Environments & secrets
.env
.env.*
# ...but keep the documented template tracked:
!.env.example
api_config.local.json
# The real config holds API keys — commit api_config.example.json instead.
# The app re-creates api_config.json with defaults when it is missing.
api_config.json

# Builds
dist/
build/

# Models & large binaries
models/*.onnx
models/*.bin
models/*.gguf
models/*.pth
*.mp4
*.mkv
*.webm
*.srt

# Output / temp
tmp/
output/
*.log

# Auto-updated safety blocklist cache (downloaded from GitHub)
safety_blocklist_cache.json
.safety_update_stamp

# v6 features
checkpoint.json
final_polished/
.polish_tmp/
updates/
update_info.json
crash_report.log
api_config.secure.json
transcription_model.json

# WebUI runtime artifacts
VIRALS/
subtitle_templates.json
temp_subtitle_config.json
client_secrets.json
client_secrets*.json
yt_token.json
token.json
*.zip
*.pem

# Local credential store used by the YouTube/TikTok/Instagram gates
.viralcutter/

# Local WebUI form preferences (machine-specific, not shared)
webui_settings.json

# Local Gradio runtime cache (created by the WebUI on first boot)
.gradio/

# Strike-feedback user-local data (learned terms + journal)
safety_terms.json
strike_feedback.json
analytics_report.json

# Coverage artifacts
.coverage
.coverage.*
htmlcov/

# Runtime safety feed (regenerated by youtube_policy_watch.py)
youtube_policy_feed.json


# Pipeline runner lock (runtime)
.pipeline_runner.lock
pipeline_runner_state.json

.oussama_policy_lexicon.sqlite3

# CI / local report artifacts (uploaded as workflow artifacts — issue #26)
quality-benchmark-*.json
quality_benchmark.json
sbom-*.json
pip-audit-*.json
licenses-*.md
windows_acceptance.json
windows_diagnostics.json
.windows-diagnostics.json

# Update-signing keys: private keys NEVER ship; the PUBLIC key may be tracked
# so packaged builds can pin the update trust root (scripts/update_manifest.py).
keys/*.key
!keys/*.pub
.browser-bridge-state/
