# ---------------------------------------------------------------------------
# v7.50: Dubbing (scripts/dubbing.py) — OPT-IN voice-over for translated clips
# ---------------------------------------------------------------------------
# The 'edge' provider sends the transcript text to Microsoft's service.
# It stays refused until you explicitly allow it here (privacy):
VIRALCUTTER_TTS_ALLOW_NETWORK=0
# Default voice for the edge provider (any edge-tts voice name):
VIRALCUTTER_TTS_VOICE=ar-EG-ShakirNeural

# ---------------------------------------------------------------------------
# v7.50: Update channel (scripts/update_manifest.py) — works without GitHub
# Releases, so it keeps working on a PRIVATE repository (issue #27).
# ---------------------------------------------------------------------------
# github (default) | manifest | off
VIRALCUTTER_UPDATE_CHANNEL=github
# URL or local path of the signed update_manifest.json (when channel=manifest):
VIRALCUTTER_UPDATE_MANIFEST=
# Public key (from `python -m scripts.sign_artifacts init`) used to verify it:
VIRALCUTTER_UPDATE_PUBLIC_KEY=
# Accept an UNSIGNED manifest (not recommended):
VIRALCUTTER_ALLOW_UNSIGNED_UPDATE=0
# مُستخدَم في 2 موضعاً بالكود
VIRALCUTTER_QUALITY_GATE=
# مُستخدَم في 2 موضعاً بالكود
VIRALCUTTER_REPETITION_PENALTY_MAX=
# مُستخدَم في 2 موضعاً بالكود
VIRALCUTTER_SEMANTIC_DUP_THRESHOLD=
# مُستخدَم في 2 موضعاً بالكود
VIRALCUTTER_STRICT_BOUNDARIES=
# مُستخدَم في 2 موضعاً بالكود
VIRALCUTTER_VARIANT_VERIFY=
# مُستخدَم في 2 موضعاً بالكود
VIRALCUTTER_VOICE_FACE_LINK=
# مُستخدَم في 2 موضعاً بالكود
VIRALCUTTER_WEBUI_USER=
