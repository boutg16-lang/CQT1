VIRALCUTTER_FASTER_WHISPER_COMPUTE_TYPE=int8
# مُستخدَم في 2 موضعاً بالكود
VIRALCUTTER_TRANSCRIPTION_BACKEND=

# --------------------------------------------------------------------
