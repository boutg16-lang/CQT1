# ====================================================================
# ملف المتغيّرات البيئية النموذجي — OUSSAMA Cutter / ViralCutter
# --------------------------------------------------------------------
# انسخ هذا الملف إلى .env ثم املأ القيم المطلوبة:
#     cp .env.example .env
#
# ⚠️  لا تضع أي مفتاح حقيقي في هذا الملف — .env.example يُرفَع إلى Git،
#     أمّا ملف .env فيجب أن يبقى محلياً ومُدرَجاً في .gitignore.
#
# المتغيّرات هنا مُستخرَجة آلياً من كود Python في المستودع (61 متغيّراً).
# ====================================================================

# --------------------------------------------------------------------
# 1) مفاتيح مزوّدي الذكاء الاصطناعي (AI / LLM)
# --------------------------------------------------------------------
# سرّي — لا تُرفَع قيمته إلى Git إطلاقاً — مُستخدَم في 12 موضعاً بالكود
GEMINI_API_KEY=
# سرّي — لا تُرفَع قيمته إلى Git إطلاقاً — مُستخدَم في 8 موضعاً بالكود
VIRALCUTTER_GEMINI_KEYS=
# سرّي — لا تُرفَع قيمته إلى Git إطلاقاً — مُستخدَم في 6 موضعاً بالكود
OPENAI_API_KEY=
# سرّي — لا تُرفَع قيمته إلى Git إطلاقاً — مُستخدَم في 6 موضعاً بالكود
OPENAI_MODERATION_API_KEY=
# سرّي — لا تُرفَع قيمته إلى Git إطلاقاً — مُستخدَم في 4 موضعاً بالكود
VIRALCUTTER_GEMINI_KEY=
# مُستخدَم في 2 موضعاً بالكود
VIRALCUTTER_GEMINI_KEY_MODE=
# مراجعة «رئيس التحرير» للمقاطع المرشحة (نظرة خبير ثانية بعد الاختيار) —
# قيمة منطقية: 1 لتفعيلها على Gemini/G4F — مُستخدَم في 1 موضع بالكود
VIRALCUTTER_EDITOR_REVIEW=
# قص تلقائي للحشو الافتتاحي من أول المقطع باستخدام توقيتات الكلمات —
# قيمة منطقية: 1 للتفعيل — مُستخدَم في 1 موضع بالكود
VIRALCUTTER_HOOK_AUTOTRIM=

# --------------------------------------------------------------------
# 2) يوتيوب والنشر (YouTube / Upload)
